# Manuscript drafts, figure sources, contracts and schedules live outside the
# repo (in the sibling manuscript/ folder). This entry stays as a safety net so a
# stray chapters/ folder is never committed. Public code lives under chapterNN/.
chapters/
manuscript/

# macOS / editor cruft
.DS_Store
**/.DS_Store
.idea/
.vscode/
*.swp
*~

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.env
.python-version

# Jupyter
.ipynb_checkpoints/
*-checkpoint.ipynb

# Build / dist
build/
dist/
*.egg

# uv / pip
.uv/
pip-log.txt

# Office lock files
~$*.docx
~$*.pptx
~$*.xlsx

# Case-study run outputs (regenerated by modal_case_study.py; not versioned)
case_study/results/*
!case_study/results/.gitkeep

# Full-pipeline Chrome traces from the Chapter 2 lab (~15 MB each); kept in the run zip, not in git
case_study/reference_results/*/traces/*/chapter02_lab/rag_decode_trace.json.gz
# Nsight Systems reports record the process environment (including tokens); never commit them
*.nsys-rep

# Chapters 10-12 case-study outputs: data, downloaded run folders, traces, raw arrays and model weights stay out of git
chapter1[0-2]/data/
chapter1[0-2]/results_remote/
chapter1[0-2]/results/*_trace.jsonl
chapter11/*/out/
chapter11/parity/ref/
*.npy
*.npz
*.safetensors
*.gguf
*.pt
*.pth
*.ckpt
*.parquet
*.arrow

# Documentation site build output
site/

# Chapter 6 working files: notebook variants, logs, plans, audits and local result folders stay out of git.
# The published notebook is chapter06_companion_2p14.ipynb.
chapter06/chapter06_companion*.ipynb
!chapter06/chapter06_companion_2p14.ipynb
chapter06/*_log.md
chapter06/*_checklist.md
chapter06/*_plan.md
chapter06/*_audit.md
chapter06/*_assessment.md
chapter06/*mockup.html
chapter06/*.log
chapter06/results_a100/
chapter06/results/*.csv
chapter06/results/environment.json
