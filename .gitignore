# Private chapter drafts (manuscripts, figures source, fundraising,
# contracts, schedules). Public release artifacts live at the repo root
# under chapterNN/ — never inside chapters/.
chapters/

# macOS / editor cruft
.DS_Store
**/.DS_Store
.idea/
.vscode/
*.swp
*~

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.env
.python-version

# Jupyter
.ipynb_checkpoints/
*-checkpoint.ipynb

# Build / dist
build/
dist/
*.egg

# uv / pip
.uv/
pip-log.txt

# Office lock files
~$*.docx
~$*.pptx
~$*.xlsx

# Case-study run outputs (regenerated by modal_case_study.py; not versioned)
case_study/results/*
!case_study/results/.gitkeep

# Full-pipeline Chrome traces from the Chapter 2 lab (~15 MB each); kept in the run zip, not in git
case_study/reference_results/*/traces/*/chapter02_lab/rag_decode_trace.json.gz
# Nsight Systems reports record the process environment (including tokens); never commit them
*.nsys-rep
